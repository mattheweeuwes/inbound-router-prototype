{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": false
  },
  "include": ["api", "src", "scripts", "test", "e2e", "server.ts", "playwright.config.ts"]
}
